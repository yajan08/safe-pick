rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Example custom claims implementation (requires Firebase Auth backend setup):
    // function isAdmin() {
    //   return isAuthenticated() && request.auth.token.role == 'admin';
    // }

    // Since you are currently using client-side roles based on the 'users' collection,
    // this is a baseline security config to prevent unauthenticated access. 
    // IMPORTANT: You should transition to Custom Claims before scaling to thousands of users.

    match /users/{userId} {
      // Users can only read/write their own profile data
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /students/{studentId} {
      // Any authenticated user (driver, parent, admin) can read student data for manifest/tracking
      allow read: if isAuthenticated();
      // Only authenticated users can update (Drivers marking attendance, Parents marking absent)
      allow write: if isAuthenticated(); 
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Should be restricted to Admins when Custom Claims are ready
      
      match /trip_manifest/{studentId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /daily_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      
      match /attendance/{studentId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
